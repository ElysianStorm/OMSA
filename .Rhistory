# Load the data
crime_data <- read.table("../datasets/ISY6501_HW3_USCrime.txt", header = TRUE)
# Load necessary library
library(outliers)
# Load the data
crime_data <- read.table("../datasets/ISY6501_HW3_USCrime.txt", header = TRUE)
# Extract the last column
crime_rates <- crime_data[, ncol(crime_data)]
# Perform Grubbs' test
grubbs_test_result <- grubbs.test(crime_rates)
# Print the result
print(grubbs_test_result)
# Plot the data to visualize outliers
boxplot(crime_rates, main = "Boxplot of Crime Rates", ylab = "Crimes per 100,000 people")
# View structure and last column summary
str(crime_data)
summary(crime_data$V16)  # Assuming last column is V16
# Visualize the data
boxplot(crime_data$V16, main = "Boxplot of Crimes per 100,000 People", col = "lightblue")
# Load necessary library
library(outliers)
# Load the data
crime_data <- read.table("../datasets/ISY6501_HW3_USCrime.txt", header = TRUE)
# Extract the last column
crime_rates <- crime_data[, ncol(crime_data)]
# View structure and last column summary
summary(crime_data$Crime)
# Perform Grubbs' test
grubbs_test_result <- grubbs.test(crime_rates)
# Print the result
print(grubbs_test_result)
# Plot the data to visualize outliers
boxplot(crime_rates, main = "Boxplot of Crime Rates", ylab = "Crimes per 100,000 people")
# Visualize the data
boxplot(crime_data$Crime, main = "Boxplot of Crimes per 100,000 People", col = "lightblue")
