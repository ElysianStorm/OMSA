# Load necessary libraries
install.packages("recommenderlab", dependencies = TRUE)
setwd("~/GitHub/OMSA")
library(recommenderlab)
# Given user-item matrix
ratings <- matrix(c(2, NA, 3, 5, 2, NA, 4, 4, 1), nrow=3, byrow=TRUE)
rownames(ratings) <- c("U1", "U2", "U3")
colnames(ratings) <- c("I1", "I2", "I3")
# Step i: Normalize by subtracting user mean
user_means <- rowMeans(ratings, na.rm = TRUE)
norm_ratings <- sweep(ratings, 1, user_means, FUN="-")
# Step ii: Compute cosine similarity between users
cos_sim <- function(x, y) {
sum(x * y, na.rm = TRUE) / (sqrt(sum(x^2, na.rm = TRUE)) * sqrt(sum(y^2, na.rm = TRUE)))
}
s12 <- cos_sim(norm_ratings["U1", ], norm_ratings["U2", ])
s13 <- cos_sim(norm_ratings["U1", ], norm_ratings["U3", ])
# Step iii: Predict rating for U1 on I2
numerator <- s12 * norm_ratings["U2", "I2"] + s13 * norm_ratings["U3", "I2"]
denominator <- abs(s12) + abs(s13)
predicted_rating <- user_means["U1"] + (numerator / denominator)
cat("Predicted rating for U1 on I2:", predicted_rating, "\n")
# Load the dataset
data("MovieLense")
# Create user ratings
user_ratings <- matrix(c(5, 4, 5, 5, 3, 4, 2, 5, 3, 4, 4, 5, 3, 5, 4), nrow=1)
colnames(user_ratings) <- c("Toy Story (1995)", "Shawshank Redemption, The (1994)", "Seven (Se7en) (1995)",
"Usual Suspects, The (1995)", "Braveheart (1995)", "Taxi Driver (1976)",
"Batman Forever (1995)", "Star Wars (1977)", "Pulp Fiction (1994)",
"Lion King, The (1994)", "Jurassic Park (1993)", "Sleepless in Seattle (1993)",
"Home Alone (1990)", "Terminator 2: Judgment Day (1991)", "Silence of the Lambs, The (1991)")
# Convert to realRatingMatrix
user_ratings_matrix <- as(user_ratings, "realRatingMatrix")
# Build UBCF model
rec_model <- Recommender(MovieLense, method = "UBCF")
# Predict top 10 recommendations
recommendations <- predict(rec_model, user_ratings_matrix, n=10)
# Load the dataset
data("MovieLense")
# Create user ratings
user_ratings <- rep(NA, ncol(MovieLense))
names(user_ratings) <- colnames(MovieLense)
rated_movies <- c("Toy Story (1995)", "Shawshank Redemption, The (1994)", "Seven (Se7en) (1995)",
"Usual Suspects, The (1995)", "Braveheart (1995)", "Taxi Driver (1976)",
"Batman Forever (1995)", "Star Wars (1977)", "Pulp Fiction (1994)",
"Lion King, The (1994)", "Jurassic Park (1993)", "Sleepless in Seattle (1993)",
"Home Alone (1990)", "Terminator 2: Judgment Day (1991)", "Silence of the Lambs, The (1991)")
ratings_values <- c(5, 4, 5, 5, 3, 4, 2, 5, 3, 4, 4, 5, 3, 5, 4)
user_ratings[rated_movies] <- ratings_values
# Convert to realRatingMatrix
user_ratings_matrix <- as(matrix(user_ratings, nrow=1), "realRatingMatrix")
# Build UBCF model
rec_model <- Recommender(MovieLense, method = "UBCF")
# Predict top 10 recommendations
recommendations <- predict(rec_model, user_ratings_matrix, n=10)
print(recommendations)
