library(kknn)
# Load the dataset
data <- read.delim("../datasets/ISY6501_HW1_credit_card_data-headers.txt", header = TRUE, sep = "\t", dec = ".")
# Handle missing values (drop rows with NA)
data <- na.omit(data)
# Train a KNN model
k <- 5
knn_model <- kknn(R1 ~ ., train=data, test=data, k=k, scale=TRUE)
# Make predictions
predictions <- fitted(knn_model)
accuracy <- sum(round(predictions) == data$R1) / nrow(data)
print(paste("KNN Accuracy with k=", k, ": ", accuracy, sep=""))
