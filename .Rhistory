# Load the dataset
data <- read.delim("../datasets/ISY6501_HW1_credit_card_data-headers.txt", header = TRUE, sep = "\t", dec = ".")
# Initialize variables
n <- nrow(data)
predictors <- scale(as.matrix(data[, 1:10]))  # Scale predictors
response <- as.factor(data[, 11])
k_values <- seq(1, 20, by = 2)
accuracies <- numeric(length(k_values))
# Loop over different k values
for (j in seq_along(k_values)) {
k <- k_values[j]
correct <- 0
# Leave-one-out cross-validation (LOOCV)
for (i in 1:n) {
# Separate training and test sets
train_data <- predictors[-i, ]
train_response <- response[-i]
test_data <- predictors[i, , drop = FALSE]  # Ensure test_data remains a matrix
# KNN prediction
model <- kknn(train_response ~ ., data.frame(train_data),
data.frame(test_data), k = k, scale = FALSE)
pred <- ifelse(as.numeric(fitted(model)) > 0.5, 1, 0)  # Convert probabilities to binary
# Compare prediction with actual value
if (pred == as.numeric(response[i]) - 1) {  # Match factor levels with binary labels
correct <- correct + 1
}
}
# Calculate accuracy
accuracies[j] <- correct / n
}
plot(k_values, accuracies, type = "b", xlab = "k", ylab = "Accuracy", main = "Accuracy vs k")
# Find the best k
best_k <- k_values[which.max(accuracies)]
best_accuracy <- max(accuracies)
# Output results
list(k_values = k_values, accuracies = accuracies, best_k = best_k, best_accuracy = best_accuracy)
