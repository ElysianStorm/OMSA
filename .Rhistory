setwd("~/GitHub/OMSA")
# Load necessary libraries
library(kmeans)
# Load the data-set
data <- read.table("../datasets/ISY6501_HW2_Iris.txt", header = TRUE)
# Step 2: Prepare the data for clustering (exclude the species column)
iris_data <- iris[, -5]
# Step 3: Scale the data to standardize it
iris_data_scaled <- scale(iris_data)
# Step 4: Determine the optimal value of k using the Elbow method
wss <- (nrow(iris_data_scaled) - 1) * sum(apply(iris_data_scaled, 2, var))
for (i in 2:15) {
wss[i] <- sum(kmeans(iris_data_scaled, centers = i)$tot.withinss)
}
# Plot the Elbow curve to visualize the best k
plot(1:15, wss, type = "b", main = "Elbow Method",
xlab = "Number of Clusters (k)", ylab = "Within-cluster Sum of Squares")
# Step 5: Perform k-means clustering with the optimal k
optimal_k <- 3  # Based on the Elbow method, k = 3 is typically optimal for the Iris data-set
kmeans_result <- kmeans(iris_data_scaled, centers = optimal_k)
# Step 6: Evaluate how well the clustering matches the actual species
table(kmeans_result$cluster, iris$Species)
# Step 7: Report the results
best_combination_of_predictors <- colnames(iris_data)  # All predictors were used
cat("Optimal k:", optimal_k, "\n")
cat("Best predictors:", best_combination_of_predictors, "\n")
cat("Clustering results:\n")
print(table(kmeans_result$cluster, iris$Species))
