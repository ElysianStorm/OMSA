# Load necessary libraries
install.packages("qcc")  # For CUSUM
# Load necessary libraries
library(qcc)
library(tidyr)
# Load the temperature data
temps_data <- read.table("../datasets/ISY6501_HW3_Temps.txt", header = TRUE, sep = "\t")
# Convert the data to a long format for easier manipulation
temps_long <- gather(temps_data, key = "Year", value = "Temperature", -DAY)
# Extract month and day from the DAY column
temps_long$Month <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%m"))
temps_long$Day <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%d"))
# Filter data for July through October
summer_data <- subset(temps_long, Month %in% 7:10)
# Function to apply CUSUM and detect end of summer
detect_end_of_summer <- function(year_data) {
# Apply CUSUM to detect a downward shift in temperature
cusum_result <- cusum(year_data$Temperature, decision.interval = 5, se.shift = 1)
# Find the first point where the CUSUM exceeds the decision interval (indicating a shift)
end_of_summer_index <- which(cusum_result$violations == 1)[1]
# Get the corresponding date
end_of_summer_date <- year_data$DAY[end_of_summer_index]
return(end_of_summer_date)
}
# Apply the function to each year
years <- unique(summer_data$Year)
end_of_summer_dates <- sapply(years, function(year) {
year_data <- subset(summer_data, Year == year)
detect_end_of_summer(year_data)
})
library(qcc)
library(tidyr)
# Load the temperature data
temps_data <- read.table("../datasets/ISY6501_HW3_Temps.txt", header = TRUE, sep = "\t")
# Convert the data to a long format for easier manipulation
temps_long <- gather(temps_data, key = "Year", value = "Temperature", -DAY)
# Extract month and day from the DAY column
temps_long$Month <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%m"))
temps_long$Day <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%d"))
# Filter data for July through October
summer_data <- subset(temps_long, Month %in% 7:10)
# Function to apply CUSUM and detect end of summer
detect_end_of_summer <- function(year_data) {
# Apply CUSUM to detect a downward shift in temperature
cusum_result <- cusum(year_data$Temperature, decision.interval = 5, se.shift = 1)
# Extract the violations (points where the CUSUM exceeds the decision interval)
violations <- cusum_result$violations
# Find the first point where a violation occurs (indicating a shift)
if (any(violations == 1)) {
end_of_summer_index <- which(violations == 1)[1]
end_of_summer_date <- year_data$DAY[end_of_summer_index]
} else {
# If no violation is found, return NA
end_of_summer_date <- NA
}
return(end_of_summer_date)
}
# Apply the function to each year
years <- unique(summer_data$Year)
end_of_summer_dates <- sapply(years, function(year) {
year_data <- subset(summer_data, Year == year)
detect_end_of_summer(year_data)
})
library(qcc)
library(tidyr)
# Load the temperature data
temps_data <- read.table("../datasets/ISY6501_HW3_Temps.txt", header = TRUE, sep = "\t")
# Convert the data to a long format
temps_long <- gather(temps_data, key = "Year", value = "Temperature", -DAY)
# Extract month and day from the DAY column
temps_long$Month <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%m"))
temps_long$Day <- as.numeric(format(as.Date(temps_long$DAY, format = "%d-%b"), "%d"))
# Filter data for July through October
summer_data <- subset(temps_long, Month %in% 7:10)
# Ensure Year is treated as a character (not factor)
summer_data$Year <- as.character(summer_data$Year)
# Function to detect end of summer using CUSUM
detect_end_of_summer <- function(year_data) {
# Apply CUSUM to detect downward shifts (cooling)
cusum_result <- cusum(year_data$Temperature, decision.interval = 5, se.shift = 1)
# Extract LOWER violations (indices where cooling starts)
violations <- cusum_result$violations$lower
# Find the first violation (if any)
if (any(violations == 1)) {
end_of_summer_index <- which(violations == 1)[1]
end_of_summer_date <- year_data$DAY[end_of_summer_index]
} else {
end_of_summer_date <- NA  # No significant cooling detected
}
return(end_of_summer_date)
}
# Apply the function to each year
years <- unique(summer_data$Year)
end_of_summer_dates <- sapply(years, function(year) {
year_data <- subset(summer_data, Year == year)
detect_end_of_summer(year_data)
})
# Convert to a data frame and handle dates
end_of_summer_df <- data.frame(
Year = years,
EndOfSummer = as.Date(end_of_summer_dates, format = "%d-%b")
)
# Remove rows with NA values
end_of_summer_df <- na.omit(end_of_summer_df)
# Plot end of summer dates
plot(end_of_summer_df$Year, end_of_summer_df$EndOfSummer,
type = "b", xlab = "Year", ylab = "End of Summer Date",
main = "End of Summer Over Years", col = "blue", pch = 19)
