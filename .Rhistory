# Create a side-by-side boxplot of medv over chas, that is, show the distributions of medv for the two groups with chas==1 and chas==0
boxplot(mean.cat_medv.ch_bound ~ mean.cat_medv.ch_unbound, data = data)
# Create a side-by-side boxplot of medv over chas, that is, show the distributions of medv for the two groups with chas==1 and chas==0
boxplot(means ~ mean.cat_medv.ch_unbound + mean.cat_medv.ch_bound, data = data)
# Create a side-by-side boxplot of medv over chas, that is, show the distributions of medv for the two groups with chas==1 and chas==0
boxplot(mean.cat_medv.ch_unbound ~ mean.cat_medv.ch_bound, data = medv)
# Create a side-by-side boxplot of medv over chas, that is, show the distributions of medv for the two groups with chas==1 and chas==0
