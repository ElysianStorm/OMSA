for (i in 1:n) {
train_data <- data[-i, 1:10]
train_response <- response[-i]
test_data <- data[i, 1:10]
# KNN prediction
model <- kknn(train_response ~ ., train_data, test_data, k = k, scale = TRUE)
pred <- as.integer(fitted(model) + 0.5)  # Convert probabilities to binary response
if (pred == response[i]) {
correct <- correct + 1
}
}
# Calculate accuracy
accuracies[j] <- correct / n
}
n <- nrow(data)
predictors <- as.matrix(data[, 1:10])
response <- as.factor(data[, 11])
k_values <- seq(1, 20, by = 2)
accuracies <- numeric(length(k_values))
# Loop over different k values
for (j in seq_along(k_values)) {
k <- k_values[j]
correct <- 0
# Leave-one-out cross-validation
for (i in 1:n) {
train_data <- data[-i, 1:10]
train_response <- response[-i]
test_data <- data[i, 1:10, drop = FALSE]  # Ensure test_data remains a data frame
# KNN prediction
model <- kknn(train_response ~ ., data.frame(train_data),
data.frame(test_data), k = k, scale = TRUE)
pred <- ifelse(as.numeric(fitted(model)) > 0.5, 1, 0)  # Convert probabilities to binary response
if (pred == as.numeric(response[i]) - 1) {  # Convert factor levels to numeric for comparison
correct <- correct + 1
}
}
# Calculate accuracy
accuracies[j] <- correct / n
}
# Find the best k
best_k <- k_values[which.max(accuracies)]
best_accuracy <- max(accuracies)
# Output results
list(best_k = best_k, best_accuracy = best_accuracy)
